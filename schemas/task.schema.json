{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "project_id", "workstream_id", "title", "type",
    "status", "priority", "risk_level", "objective", "scope", "acceptance_criteria",
    "source", "assignee", "dependencies", "requires_review", "automation_policy",
    "artifacts", "runs", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "project_id": { "type": "string", "minLength": 1 },
    "workstream_id": { "type": "string", "minLength": 1 },
    "parent_task_id": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["feature", "bug", "maintenance", "research", "documentation", "operations", "review", "custom"]
    },
    "status": {
      "type": "string",
      "enum": ["captured", "backlog", "ready", "queued", "in_progress", "in_review", "done", "blocked", "cancelled"]
    },
    "priority": { "type": "string", "enum": ["urgent", "high", "medium", "low", "none"] },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "objective": { "type": "string", "minLength": 1 },
    "background": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": { "type": "string", "enum": ["manual", "github_issue", "comment", "loop", "handoff", "agent", "external"] },
        "ref": { "type": ["string", "null"] },
        "deduplication_key": { "type": ["string", "null"] }
      }
    },
    "assignee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["human", "agent", "squad", "unassigned"] },
        "id": { "type": ["string", "null"] }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocked_reason": { "type": ["string", "null"] },
    "cancellation_reason": { "type": ["string", "null"] },
    "requires_review": { "type": "boolean" },
    "automation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_dispatch", "max_runs", "timeout_minutes", "on_failure", "on_no_review"],
      "properties": {
        "auto_dispatch": { "type": "boolean" },
        "max_runs": { "type": "integer", "minimum": 1 },
        "timeout_minutes": { "type": "integer", "minimum": 1 },
        "on_failure": { "type": "string", "enum": ["return_to_ready", "block", "cancel"] },
        "on_no_review": { "type": "string", "enum": ["stay_in_review", "auto_complete_low_risk", "block"] },
        "cost_budget": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff", "feedback", "branch", "commits", "pull_request", "documents"],
      "properties": {
        "handoff": { "type": ["string", "null"] },
        "feedback": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "commits": { "type": "array", "items": { "type": "string" } },
        "pull_request": { "type": ["string", "null"] },
        "documents": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": ["string", "null"] }
  }
}
